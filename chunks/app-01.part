  function cloneSeed() {
    return JSON.parse(JSON.stringify(seed));
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return cloneSeed();
      const parsed = JSON.parse(raw);
      if (parsed.version !== APP_VERSION) return cloneSeed();
      return parsed;
    } catch (error) {
      console.warn('Impossible de charger la maquette locale.', error);
      return cloneSeed();
    }
  }

  function saveState() {
    state.version = APP_VERSION;
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function updateState(mutator, message = '') {
    mutator(state);
    saveState();
    render();
    if (message) toast(message, 'success');
  }

  function getCompany(id) { return state.companies.find(item => item.id === id); }
  function getClient(id) { return state.clients.find(item => item.id === id); }
  function getUser(id) { return state.users.find(item => item.id === id); }
  function getAffaire(id) { return state.affaires.find(item => item.id === id); }
  function getWorkflow(id) { return state.workflows.find(item => item.id === id); }
  function getRepere(id) { return state.reperes.find(item => item.id === id); }
  function getIntervention(id) { return state.interventions.find(item => item.id === id); }

  function formatDate(value, options = { day: '2-digit', month: 'short', year: 'numeric' }) {
    if (!value) return 'Non défini';
    const date = new Date(value.length === 10 ? `${value}T12:00:00` : value);
    return new Intl.DateTimeFormat(DATE_LOCALE, options).format(date);
  }

  function formatMoney(value) {
    return new Intl.NumberFormat(DATE_LOCALE, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(Number(value || 0));
  }

  function formatBytes(bytes) {
    const value = Number(bytes || 0);
    if (value < 1024) return `${value} o`;
    if (value < 1024 * 1024) return `${Math.round(value / 1024)} Ko`;
    return `${(value / 1024 / 1024).toFixed(1)} Mo`;
  }

  function initials(name = '') {
    return name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase() || 'A3';
  }

  function repereProgress(repere) {
    const workflow = getWorkflow(repere.workflowId);
    if (!workflow || !workflow.phases.length) return 0;
    if (repere.status === 'done') return 100;
    const index = clamp(Number(repere.phaseIndex || 0), 0, workflow.phases.length - 1);
    const completedWeight = workflow.phases.slice(0, index).reduce((sum, phase) => sum + Number(phase.weight || 0), 0);
    const currentWeight = Number(workflow.phases[index]?.weight || 0) * (repere.status === 'in_progress' || repere.status === 'blocked' ? 0.45 : 0);
    const total = workflow.phases.reduce((sum, phase) => sum + Number(phase.weight || 0), 0) || 100;
    return clamp(Math.round(((completedWeight + currentWeight) / total) * 100), 0, 100);
  }

