 }
.product-code { min-width: 38px; height: 30px; padding: 0 7px; display: inline-grid; place-items: center; border-radius: 8px; color: var(--blue-dark); background: var(--blue-soft); font-size: 8px; font-weight: 850; letter-spacing: .03em; }
.phase-state { width: 27px; height: 27px; display: inline-grid; place-items: center; border-radius: 8px; }
.phase-state .icon { width: 14px; }
.phase-state--done { color: var(--green); background: var(--green-soft); }
.phase-state--blocked { color: var(--red); background: var(--red-soft); }
.phase-state--planned { color: var(--purple); background: var(--purple-soft); }
.phase-state--waiting { width: 9px; height: 9px; border-radius: 50%; background: var(--line-strong); }
.phase-state--active { background: var(--blue-soft); }
.phase-state--active span { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 4px rgba(23,111,192,.12); animation: pulse 1.8s infinite; }
.phase-state--na { color: var(--muted-2); background: var(--surface-muted); }
@keyframes pulse { 0%,100% { box-shadow:0 0 0 4px rgba(23,111,192,.12); } 50% { box-shadow:0 0 0 7px rgba(23,111,192,.04); } }
.table-progress { min-width: 85px; display: flex; align-items: center; gap: 8px; }
.table-progress .progress-track { flex: 1; }
.table-progress strong { font-size: 8px; }
.dashboard-bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.compact-list,.activity-list { padding: 7px 11px 11px; }
.compact-row { width: 100%; padding: 9px 5px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line); border-radius: 8px; color: inherit; background: transparent; text-align: left; }
.compact-row:last-child { border-bottom: 0; }
.compact-row:hover { background: var(--surface-muted); }
.date-tile { width: 38px; height: 38px; display: grid; place-items: center; align-content: center; border-radius: 10px; background: var(--surface-soft); line-height: 1; }
.date-tile strong { font-size: 13px; }
.date-tile small { margin-top: 3px; color: var(--muted); font-size: 7px; text-transform: uppercase; }
.date-tile--large { width: 54px; height: 54px; border-radius: 13px; }
.date-tile--large strong { font-size: 19px; }
.compact-row__copy { min-width: 0; flex: 1; display: grid; gap: 3px; }
.compact-row__copy strong { font-size: 9.5px; }
.compact-row__copy small { color: var(--muted); font-size: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.activity-row { padding: 9px 5px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line); }
.activity-row:last-child { border-bottom: 0; }
.activity-row__marker { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 9px; }
.activity-row__marker--success { color: var(--green); background: var(--green-soft); }
.activity-row__marker--danger { color: var(--red); background: var(--red-soft); }
.activity-row__marker--info { color: var(--blue); background: var(--blue-soft); }
.activity-row__marker .icon { width: 14px; }
.activity-row > span:last-child { display: grid; gap: 2px; }
.activity-row strong { font-size: 9px; }
.activity-row small { color: var(--muted); font-size: 7.5px; }

.status-pill { min-height: 22px; padding: 0 8px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; font-size: 7.5px; font-weight: 830; white-space: nowrap; }
.status-pill--planned,.status-pill--neutral { color: var(--muted); background: var(--surface-soft); }
.status-pill--info { color: var(--blue-dark); background: var(--blue-soft); }
.status-pill--success { color: var(--green); background: var(--green-soft); }
.status-pill--warning { color: var(--amber); background: var(--amber-soft); }
.status-pill--danger { color: var(--red); background: var(--red-soft); }
.text-danger { color: var(--red) !important; }
.muted-label { color: var(--muted); font-size: 8px; }
.avatar-stack { display: flex; align-items: center; min-height: 25px; }

.filter-bar,.toolbar,.planning-toolbar { margin-bottom: 16px; padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); box-shadow: var(--shadow-xs); }
.filter-bar { justify-content: flex-start; }
.filter-bar .icon-button { margin-left: auto; }
.toolbar--wrap { flex-wrap: wrap; }
.toolbar__group { display: flex; align-items: center; gap: 9px; }
.toolbar__result { color: var(--muted); font-size: 9px; }
.select-control,.field--inline { display: flex; align-items: center; gap: 8px; }
.select-control > span,.field--inline > label { color: var(--muted); font-size: 8px; font-weight: 750; }
.select-control select,.compact-select,.field--inline select { min-height: 34px; padding: 0 30px 0 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface-muted); color: var(--ink); font-size: 9px; }
.segmented { display: inline-flex; padding: 3px; border-radius: 10px; background: var(--surface-soft); }
.segmented button { min-height: 33px; padding: 0 11px; display: inline-flex; align-items: center; gap: 6px; border-radius: 8px; background: transparent; color: var(--muted); font-size: 8.5px; font-weight: 760; }
.segmented button .icon { width: 15px; }
.segmented button.is-active { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-xs); }

.affaire-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 15px; }
.affaire-card { min-width: 0; padding: 17px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow-xs); transition: transform var(--transition),box-shadow var(--transition); }
.affaire-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
.affaire-card__head,.affaire-card__footer,.affaire-card__progress > div:first-child { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.client-mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; background: color-mix(in srgb,var(--company-color,var(--blue)) 14%,var(--surface)); color: var(--company-color,var(--blue)); font-size: 10px; font-weight: 850; }
.affaire-card__main { width: 100%; margin: 16px 0 15px; padding: 0; color: inherit; background: transparent; text-align: left; }
.affaire-card__main h2 { margin: 5px 0 7px; font-size: 15px; line-height: 1.25; letter-spacing: -.02em; }
.affaire-card__main p { margin: 0; display: flex; align-items: center; gap: 5px; color: var(--muted); font-size: 9px; }
.affaire-card__main .icon { width: 13px; }
.affaire-card__progress { margin-bottom: 15px; }
.affaire-card__progress > div:first-child { margin-bottom: 6px; color: var(--muted); font-size: 8px; }
.affaire-card__progress strong { color: var(--ink); }
.affaire-card__stats { padding: 13px 0; display: grid; grid-template-columns: repeat(3,1fr); border-block: 1px solid var(--line); }
.affaire-card__stats div { display: grid; gap: 3px; text-align: center; border-right: 1px solid var(--line); }
.affaire-card__stats div:last-child { border-right: 0; }
.affaire-card__stats span { color: var(--muted-2); font-size: 7px; text-transform: uppercase; }
.affaire-card__stats strong { font-size: 10px; }
.affaire-card__footer { padding-top: 13px; }
.user-inline { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 8px; }

.kanban-board { display: grid; grid-template-columns: repeat(4,minmax(260px,1fr)); gap: 13px; overflow-x: auto; padding-bottom: 7px; scrollbar-width: thin; }
.kanban-lane { min-width: 260px; min-height: 560px; padding: 10px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface-soft); transition: border var(--transition),background var(--transition); }
.kanban-lane.is-drop-target { border-color: var(--blue); background: var(--blue-soft); }
.kanban-lane__head { padding: 5px 4px 12px; display: flex; align-items: center; justify-content: space-between; }
.kanban-lane__head > div { display: flex; align-items: center; gap: 7px; }
.kanban-lane__head strong { font-size: 10px; }
.kanban-lane__head > span { min-width: 22px; height: 20px; display: grid; place-items: center; border-radius: 999px; background: var(--surface); color: var(--muted); font-size: 8px; }
.lane-dot { width: 8px; height: 8px; border-radius: 50%; }
.lane-dot--neutral { background: var(--muted-2); }
.lane-dot--info { background: var(--blue); }
.lane-dot--danger { background: var(--red); }
.lane-dot--success { background: var(--green); }
.kanban-lane__body { display: grid; gap: 9px; }
.repere-card { padding: 13px; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); box-shadow: var(--shadow-xs); cursor: grab; transition: transform var(--transition),box-shadow var(--transition),opacity var(--transition); }
.repere-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
.repere-card.is-dragging { opacity: .45; transform: rotate(1deg); }
.repere-card__head,.repere-card__phase,.repere-card__footer { display: flex; align-items: center; justify-content: space-between; gap: 9px; }
.priority-dot { width: 8px; height: 8px; border-radius: 50%; }
.priority-dot--normal { background: var(--line-strong); }
.priority-dot--high { background: var(--amber); }
.priority-dot--critical { background: var(--red); box-shadow: 0 0 0 4px var(--red-soft); }
.repere-card h3 { margin: 12px 0 3px; font-size: 12px; }
.repere-card p { margin: 0 0 5px; color: var(--muted); font-size: 8.5px; }
.repere-card > small { display: flex; align-items: center; gap: 4px; color: var(--muted-2); font-size: 7.5px; }
.repere-card > small .icon { width: 12px; }
.inline-alert { margin: 11px 0; padding: 8px; display: flex; align-items: center; gap: 6px; border-radius: 9px; color: var(--red); background: var(--red-soft); font-size: 8px; font-weight: 720; }
.inline-alert .icon { width: 14px; }
.repere-card__phase { margin: 13px 0 6px; color: var(--muted); font-size: 8px; }
.repere-card__phase strong { color: var(--ink); }
.repere-card__footer { margin-top: 11px; }
.lane-empty { min-height: 95px; display: grid; place-items: center; border: 1px dashed var(--line-strong); border-radius: 11px; color: var(--muted-2); font-size: 8px; }

.planning-toolbar { margin-bottom: 14px; }
.week-navigation { display: flex; gap: 6px; }
.planning-toolbar > strong { color: var(--ink-soft); font-size: 10px; }
.planning-layout { display: grid; grid-template-columns: minmax(0,1fr) 285px; gap: 15px; }
.planning-board { overflow: auto; }
.planning-days { min-width: 980px; display: grid; grid-template-columns: repeat(7,1fr); min-height: 630px; }
.planning-day { min-width: 140px; border-right: 1px solid var(--line); transition: background var(--transition); }
.planning-day:last-child { border-right: 0; }
.planning-day.is-drop-target { background: var(--blue-soft); }
.planning-day__head { height: 65px; display: grid; place-items: center; align-content: center; border-bottom: 1px solid var(--line); background: var(--surface-muted); }
.planning-day__head span { color: var(--muted); font-size: 8px; text-transform: uppercase; }
.planning-day__head strong { margin-top: 3px; font-size: 16px; }
.planning-day.is-today .planning-day__head strong { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; background: var(--brand); color: white; }
.planning-day__body { min-height: 560px; padding: 8px; display: flex; flex-direction: column; gap: 8px; }
.planning-card { padding: 10px; border: 1px solid var(--line); border-left: 3px solid var(--blue); border-radius: 10px; background: var(--surface); box-shadow: var(--shadow-xs); cursor: grab; text-align: left; transition: transform var(--transition),box-shadow var(--transition),opacity var(--transition); }
.planning-card:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); }
.planning-card.is-dragging { opacity: .45; }
.planning-card--pose { border-left-color: var(--blue); }
.planning-card--reglage { border-left-color: var(--purple); }
.planning-card--releve { border-left-color: var(--green); }
.planning-card--sav { border-left-color: var(--red); }
.planning-card__time { margin-bottom: 5px; color: var(--muted); font-size: 7.5px; }
.planning-card > strong { display: block; font-size: 9px; }
.planning-card > small { display: block; margin-top: 3px; color: var(--muted); font-size: 7px; }
.planning-card__footer { margin-top: 9px; display: flex; align-items: center; justify-content: space-between; gap: 5px; }
.day-empty { min-height: 85px; display: grid; place-items: center; color: var(--muted-2); font-size: 7.5px; }
.unassigned-panel { max-height: 700px; }
.unassigned-list { min-height: 300px; padding: 10px; display: grid; align-content: start; gap: 9px; }
.unassigned-list.is-drop-target { background: var(--amber-soft); }

.intervention-layout { display: grid; grid-template-columns: minmax(0,1fr) 330px; gap: 16px; align-items: start; }
.intervention-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 13px; }
.intervention-card { min-width: 0; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow-xs); overflow: hidden; }
.intervention-card__main { width: 100%; padding: 15px; display: flex; align-items: flex-start; gap: 13px; color: inherit; background: transparent; text-align: left; }
.intervention-card__copy { min-width: 0; flex: 1; }
.intervention-card__copy h2 { margin: 8px 0 3px; font-size: 13px; }
.intervention-card__copy p { margin: 0 0 6px; color: var(--muted); font-size: 8.5px; }
.intervention-card__copy > small { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; color: var(--muted-2); font-size: 7.5px; }
.intervention-card__copy > small .icon { width: 12px; }
.intervention-card__meta { padding: 12px 15px; display: grid; grid-template-columns: 1.3fr .7fr .6fr; gap: 10px; border-block: 1px solid var(--line); background: var(--surface-muted); }
.intervention-card__meta > div { display: grid; align-content: start; gap: 5px; }
.intervention-card__meta span { color: var(--muted-2); font-size: 7px; text-transform: uppercase; }
.intervention-card__meta strong { font-size: 9px; }
.intervention-card__actions { padding: 10px 12px; display: flex; justify-content: flex-end; gap: 6px; }
.phone-preview { position: sticky; top: calc(var(--topbar-height) + 18px); padding: 22px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: var(--radius-md); background: linear-gradient(145deg,var(--surface-soft),var(--surface)); }
.phone-frame { width: 280px; max-width: 100%; border: 8px solid #0a1320; border-radius: 32px; background: var(--surface-muted); box-shadow: 0 25px 55px rgba(5,17,34,.22); overflow: hidden; }
.phone-frame__header { padding: 14px 15px 22px; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(145deg,#0b1728,#152943); color: white; }
.phone-frame__header > div { display: flex; align-items: center; gap: 8px; }
.phone-frame__header small { color: #91a2b7; font-size: 8px; }
.phone-frame__body { padding: 15px; }
.phone-frame__body h2 { margin: 6px 0 3px; font-size: 17px; }
.phone-frame__body > p { margin: 0 0 14px; color: var(--muted); font-size: 9px; }
.phone-frame__body h3 { margin: 18px 0 8px; font-size: 10px; }
.phone-info { margin: 7px 0; display: flex; align-items: flex-start; gap: 7px; color: var(--muted); font-size: 8px; line-height: 1.45; }
.phone-info .icon { width: 14px; }
.phone-checklist { margin-bottom: 14px; display: grid; gap: 6px; }
.phone-check { min-height: 38px; padding: 7px 9px; display: flex; align-items: center; gap: 8px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink-soft); text-align: left; font-size: 8px; }
.phone-check > span { width: 20px; height: 20px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 6px; }
.phone-check > span .icon { width: 13px; }
.phone-check.is-done { color: var(--green); background: var(--green-soft); border-color: transparent; }
.phone-check.is-done > span { color: white; background: var(--green); border-color: var(--green); }

.workflow-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 15px; }
.workflow-card { padding: 18px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow-xs); }
.workflow-card__head,.workflow-card__footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.workflow-code { width: 44px; height: 36px; display: grid; place-items: center; border-radius: 10px; background: var(--blue-soft); color: var(--blue-dark); font-size: 10px; font-weight: 850; }
.workflow-card h2 { margin: 14px 0 3px; font-size: 15px; }
.workflow-card > p { margin: 0; color: var(--muted); font-size: 8.5px; }
.workflow-phases { margin: 16px 0; display: grid; grid-template-columns: repeat(2,1fr); gap: 7px; }
.workflow-phase { min-width: 0; min-height: 38px; padding: 6px 8px; display: grid; grid-template-columns: 22px minmax(0,1fr) auto; align-items: center; gap: 7px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface-muted); }
.workflow-phase > span { width: 22px; height: 22px; display: grid; place-items: center; border-radius: 7px; background: var(--surface); color: var(--muted); font-size: 7px; }
.workflow-phase strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 8px; }
.workflow-phase small { color: var(--muted); font-size: 7px; }
.workflow-card__footer { padding-top: 13px; border-top: 1px solid var(--line); }
.workflow-card__footer > strong { color: var(--muted); font-size: 8px; }

.document-panel { padding: 13px; }
.document-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
.document-card { min-width: 0; padding: 13px; display: flex; align-items: center; gap: 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-muted); }
.document-card__icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 11px; color: var(--blue); background: var(--blue-soft); }
.document-card__copy { min-width: 0; flex: 1; }
.document-card__copy h3 { margin: 7px 0 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; }
.document-card__copy p { margin: 0 0 4px; color: var(--muted); font-size: 8px; }
.document-card__copy small { color: var(--muted-2); font-size: 7px; }
.document-card__actions { display: flex; gap: 3px; }

.settings-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 15px; }
.settings-card .panel__header { align-items: center; }
.settings-card .panel__header > .icon { width: 22px; }
.settings-list { padding: 6px 17px 15px; }
.setting-row { min-height: 70px; display: flex; align-items: center; gap: 14px; border-bottom: 1px solid var(--line); }
